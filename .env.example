# ==============================================================================
# A股量化系统环境变量配置模版 (.env.example)
# 使用方法: 复制此文件为 .env 并按需填写 (注意: .env 文件已被 gitignore, 严禁提交真实凭证)
# ==============================================================================

# 运行环境标记: 设为 1 时激活生产环境严格熔断防御 (fail-closed, 禁止 research 模式)
PRODUCTION_RUNTIME=0

# 盘后决策推送 Webhook (支持飞书 / 企业微信 / 钉钉机器人)
# 示例: https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
QUANT_WEBHOOK_URL=

# 消息通知渠道 (可选: "feishu" | "wechat" | "dingtalk", 默认 feishu)
QUANT_NOTIFIER_CHANNEL=feishu

# 迅投 MiniQMT 自动化交易配置 (可选，若仅使用内置 PaperBroker 仿真回测则无需配置)
# MiniQMT 安装根目录或 userdata_mini 路径
MINIQMT_PATH=
# 券商资金账号
MINIQMT_ACCOUNT_ID=
# 账号类型: STOCK (A股现货) 或 CREDIT (两融)
MINIQMT_ACCOUNT_TYPE=STOCK

# 系统全局网络超时 (秒)
NETWORK_TIMEOUT_SECONDS=30
